{
  "name": "codex-dev-ephemeral",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "workspaceFolder": "/workspaces",

  "mounts": [
    "source=${localEnv:HOME}/dev_spaces,target=/workspaces,type=bind"
  ],

  "remoteUser": "node",

  "postCreateCommand": "bash /workspaces/codex-dev/.devcontainer/postCreateCommand.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}